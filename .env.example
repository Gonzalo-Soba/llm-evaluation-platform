# Copy this file to .env and fill in real values. Never commit .env.
# The classifier provider ("mock" or "openai_compatible") is chosen per request in config.provider, not here.

# Base URL the .NET API uses to reach the Python classifier service (local runs; docker compose sets its own).
CLASSIFIER_SERVICE_URL=http://localhost:8000

# Base URL of an OpenAI-compatible chat completions API, used by the "openai_compatible" provider.
# Example: Groq's OpenAI-compatible endpoint.
LLM_BASE_URL=https://api.groq.com/openai/v1

# Default model for the "openai_compatible" provider. A request's config.model overrides it.
LLM_MODEL=

# API key for the LLM provider. Never commit it or paste it in logs.
LLM_API_KEY=
