# Copy this file to .env and fill in real values. Never commit .env.

# Base URL the .NET API uses to reach the Python classifier service.
CLASSIFIER_SERVICE_URL=http://localhost:8000

# Classifier backend used by the classifier service: "mock" (deterministic, no API calls) or an LLM provider name.
LLM_PROVIDER=mock

# Model identifier for the selected LLM provider. Ignored when LLM_PROVIDER=mock.
LLM_MODEL=

# API key for the selected LLM provider. Ignored when LLM_PROVIDER=mock.
LLM_API_KEY=
