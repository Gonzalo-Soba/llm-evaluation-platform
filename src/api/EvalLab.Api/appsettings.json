{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ClassifierService": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 30
  },
  "Datasets": {
    "Directory": "../../../data"
  },
  "Runs": {
    "Directory": "../../../runs"
  },
  "Evaluation": {
    "MaxParallelism": 4
  }
}
